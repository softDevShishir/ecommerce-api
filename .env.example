# Database Configuration
# DB_PORT is also used as the host-side port docker-compose publishes Postgres
# on (see docker-compose.yml) — 5434 avoids clashing with a native postgres
# service on 5432 and the ecommerce_test_pg container on 5433.
DB_HOST=localhost
DB_PORT=5434
DB_NAME=ecommerce_db
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_password

# JWT Configuration
JWT_SECRET=your-secret-key-min-256-bits-long-for-production-change-this-to-something-secure
JWT_EXPIRATION=86400000

# Server Configuration
SERVER_PORT=8080

# Application Profile (dev, prod) — read by Spring Boot's own SPRING_PROFILES_ACTIVE
# convention; docker-compose.yml passes this through automatically.
SPRING_PROFILES_ACTIVE=dev

# CORS Configuration — comma-separated list, read by SecurityConfig via app.cors.allowed-origins
# (see application.yml). Only takes effect on the base/no-profile config; application-prod.yml
# does not override it, so it applies there too.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual values in .env
# 3. NEVER commit .env to Git (already in .gitignore)
# 4. Use .env for local development (docker-compose reads it automatically)
# 5. For production, set environment variables in your deployment platform
#
# Note: SERVER_PORT, SPRING_PROFILES_ACTIVE, DB_*, and JWT_* above are the only vars this
# project's Spring config actually reads. Vars previously listed here (SWAGGER_ENABLED,
# MAIL_*, SERVER_SERVLET_CONTEXT_PATH, LOG_LEVEL) were removed — nothing in
# src/main/resources/*.yml consumes them, so setting them had no effect.
